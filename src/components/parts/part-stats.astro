---
/**
 * part-stats.astro — sezione «Stats» della scheda parte: tre barre ATK / DEF / STA col numero.
 * Una parte a due stati (`statsAlt`) ha due righe per statistica, sempre visibili: «Mode 1/2» per un
 * modo scelto dal giocatore, «Start / After the shift» per un cambio durante lo scontro, o i nomi propri
 * del produttore (`labels`). La scala e' il massimo del catalogo per quella categoria (build-data.ts),
 * calcolato su entrambi gli stati. Una parte senza `stats` non rende nulla (nemmeno il titolo).
 */
import { t } from '../../i18n/ui';
import type { PartStats, PartStatsAlt } from '../../lib/types';

interface Props {
  name: string;
  stats?: PartStats;
  statsAlt?: PartStatsAlt;
  scale: PartStats;
}
const { name, stats, statsAlt, scale } = Astro.props;
const locale = 'en';

const AXES = [
  { key: 'atk', label: t(locale, 'partStats.atk') },
  { key: 'def', label: t(locale, 'partStats.def') },
  { key: 'sta', label: t(locale, 'partStats.sta') },
] as const;

const stateLabels: [string, string] | null = !statsAlt
  ? null
  : statsAlt.labels ?? (statsAlt.kind === 'mode'
    ? [t(locale, 'partStats.mode1'), t(locale, 'partStats.mode2')]
    : [t(locale, 'partStats.shift1'), t(locale, 'partStats.shift2')]);

const states = stats ? (statsAlt ? [stats, statsAlt.stats] : [stats]) : [];
const pct = (value: number, max: number) => (max > 0 ? Math.min(100, Math.round((value / max) * 1000) / 10) : 0);

const note = statsAlt
  ? t(locale, statsAlt.kind === 'mode' ? 'partStats.modeNote' : 'partStats.shiftNote', { name })
  : null;
const scaleNote = t(locale, 'partStats.scale', { atk: String(scale.atk), def: String(scale.def), sta: String(scale.sta) });
---

{stats && (
  <>
    <h2>{t(locale, 'partStats.title')}</h2>
    <div class="part-stats" data-testid="part-stats">
      {AXES.map((axis) => (
        <div class="ps-group" data-axis={axis.key}>
          <div class="ps-axis" style={`color:var(--c-stat-${axis.key})`}>{axis.label}</div>
          <div class="ps-lines">
            {states.map((state, i) => (
              <div class={`ps-line${i === 1 ? ' ps-line-alt' : ''}`}>
                {stateLabels && <span class="ps-state">{stateLabels[i]}</span>}
                <div class="ps-track">
                  <div class="ps-fill" style={`width:${pct(state[axis.key], scale[axis.key])}%;background:var(--c-stat-${axis.key})`}></div>
                </div>
                <span class="ps-num">{state[axis.key]}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
      {note && <div class="ps-note">{note}</div>}
      <div class="ps-scale">{scaleNote}</div>
    </div>
  </>
)}

<style>
  .part-stats {
    max-width: 48rem;
    margin-bottom: 1rem;
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-surface);
  }
  .ps-group {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0.25rem 0.75rem;
    align-items: center;
    padding: 0.5rem 0;
    border-top: 1px solid var(--color-hairline);
  }
  .ps-group:first-child {
    border-top: 0;
    padding-top: 0.25rem;
  }
  .ps-axis {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
  }
  .ps-lines {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.375rem;
  }
  .ps-line {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.5rem;
  }
  .ps-line-alt .ps-fill {
    opacity: 0.55;
  }
  .ps-state {
    flex: none;
    width: 7.25rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--color-text-2);
    overflow-wrap: anywhere;
  }
  .ps-track {
    flex: 1 1 0;
    min-width: 0;
    height: 8px;
    overflow: hidden;
    border-radius: 4px;
    background: var(--color-track);
  }
  .ps-fill {
    height: 100%;
    border-radius: 4px;
  }
  .ps-num {
    flex: none;
    width: 1.75rem;
    text-align: right;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-text);
  }
  .ps-note {
    margin-top: 0.5rem;
    padding-top: 0.625rem;
    border-top: 1px solid var(--color-hairline);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-2);
  }
  .ps-scale {
    margin-top: 0.625rem;
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--color-muted);
  }
  @media (max-width: 639px) {
    .ps-group {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
