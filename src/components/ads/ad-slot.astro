---
// Slot annuncio AdSense responsive. Non renderizza nulla in dev, senza client o senza id slot.
import { ADSENSE_CLIENT, AD_SLOTS, type AdSlotName } from '../../lib/ads-config';

interface Props { slot: AdSlotName }

const { slot } = Astro.props;
const slotId = AD_SLOTS[slot];
const enabled = import.meta.env.PROD && !!ADSENSE_CLIENT && !!slotId;
---

{enabled && (
  <div class="my-4" data-ad-slot-name={slot}>
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={ADSENSE_CLIENT}
      data-ad-slot={slotId}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>
)}
