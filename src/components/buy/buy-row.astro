---
/**
 * buy-row.astro — link Amazon per una o più parti, renderizzati lato server (nell'HTML, non
 * costruiti da un'isola al click come in combo-card.tsx): una pagina editoriale deve avere un
 * link vero anche senza JavaScript, per lo stesso motivo per cui non ce l'ha la home — un crawler
 * non clicca (known issue in projects/web-frontend.md, 19/09/2026).
 *
 * Renderizza col `defaultMarketplace` di data/amazon-config.json, poi lo stato condiviso di
 * `src/lib/marketplace.ts` riscrive gli href per il negozio del visitatore (paese rilevato, o
 * scelta salvata, o lingua del browser). Il menù e la nota che spiega la scelta stanno in
 * `market-picker.astro`, montato qui e nell'header.
 *
 * Quando è il visitatore ad aver scelto il negozio, i link portano anche `creatorsDisableRedirect`:
 * senza, Amazon lo sposterebbe da sé sul negozio del suo paese, annullando la scelta appena fatta.
 */
import productsData from '../../../data/products.json';
import amazonConfig from '../../../data/amazon-config.json';
import amazonAsins from '../../../data/amazon-asins.json';
import MarketPicker from '../market-picker.astro';
import { buildPartLookup, buildAmazonUrl, storeLinks, type AmazonConfigFile, type AsinIndex } from '../../lib/amazon';

interface Part {
  category: string;
  partId: string;
  partName: string;
}
interface Props {
  parts: Part[];
}
const { parts } = Astro.props;

const config = amazonConfig as AmazonConfigFile;
const lookup = buildPartLookup(productsData);
const asins = amazonAsins as AsinIndex;
const market = config.defaultMarketplace;

// Accanto al link principale, che lo script riscrive per il negozio del visitatore, una riga fissa con
// tutti i negozi: il link al prodotto su amazon.fr col tag francese deve esistere nell'HTML anche per
// chi non è in Francia o non esegue JavaScript, come il revisore Amazon (vedi storeLinks).
const rows = parts.map((p) => ({
  ...p,
  ...buildAmazonUrl(p.category, p.partId, p.partName, lookup, asins, market, config),
  stores: storeLinks(config, (m) =>
    buildAmazonUrl(p.category, p.partId, p.partName, lookup, asins, m, config, true).href),
}));
---

<div class="my-6 rounded-lg border border-border bg-surface p-4">
  <div class="mb-3 flex flex-wrap items-start justify-between gap-2">
    <p class="font-mono text-[11px] uppercase tracking-[0.06em] text-muted">Where to buy</p>
    <MarketPicker class="items-end" />
  </div>
  <ul class="flex flex-col gap-2" data-buy-row data-market={market}>
    {rows.map((r) => (
      <li>
        <a
          href={r.href}
          data-part-id={r.partId}
          data-part-name={r.partName}
          data-category={r.category}
          data-testid="buy-part"
          target="_blank"
          rel="sponsored noopener nofollow"
          class="inline-flex items-center gap-2 font-mono text-[12px] text-gold hover:underline"
        >
          {r.partName} — Buy on Amazon
        </a>
        <p class="mt-0.5 font-mono text-[10px] text-muted" data-testid="buy-part-stores">
          {r.stores.map((s, i) => (
            <>
              {i > 0 && ' · '}
              <a
                href={s.href}
                data-market={s.market}
                target="_blank"
                rel="sponsored noopener nofollow"
                class="hover:text-text hover:underline"
              >{s.tld}</a>
            </>
          ))}
        </p>
      </li>
    ))}
  </ul>
</div>

<script>
  import { subscribeMarket, type MarketSource } from '../../lib/marketplace';
  import amazonConfig from '../../../data/amazon-config.json';
  import productsData from '../../../data/products.json';
  import amazonAsins from '../../../data/amazon-asins.json';
  import { buildPartLookup, buildAmazonUrl } from '../../lib/amazon';

  const available = Object.keys(amazonConfig.marketplaces);
  const lookup = buildPartLookup(productsData);

  /** Riscrive i link di ogni blocco: in pagina possono essercene più d'uno. */
  function applica(market: string, source: MarketSource) {
    document.querySelectorAll<HTMLUListElement>('[data-buy-row]').forEach((row) => {
      row.dataset.market = market;
      row.querySelectorAll<HTMLAnchorElement>('a[data-testid=buy-part]').forEach((a) => {
        const category = a.dataset.category!;
        const partId = a.dataset.partId!;
        // Il nome da un attributo, non dal testo del link: il testo porta gli spazi e l'a capo del
        // markup, la regex che toglieva « — Buy on Amazon» non combaciava più, e le ricerche partivano
        // per « Cobalt Dragoon — Buy on Amazon» (visto il 23/09/2026 da un visitatore US).
        const name = a.dataset.partName || partId;
        const { href } = buildAmazonUrl(
          category, partId, name, lookup, amazonAsins as any, market, amazonConfig as any, source === 'user',
        );
        a.href = href;
      });
    });
  }

  subscribeMarket(available, amazonConfig.defaultMarketplace, applica);
</script>
