---
import BaseLayout from '../layouts/base-layout.astro';
import AdSlot from '../components/ads/ad-slot.astro';
import ComboSearch from '../components/search/combo-search';
import partsData from '../../data/parts.json';
import combosData from '../../data/combos.json';
import { toSlim, INITIAL_COMBOS } from '../lib/slim-combos';
import type { CombosDatabase } from '../lib/types';
import productsData from '../../data/products.json';
import amazonConfig from '../../data/amazon-config.json';
import amazonAsins from '../../data/amazon-asins.json';
import { buildPartLookup, type AmazonConfigFile, type AsinIndex } from '../lib/amazon';
import en from '../i18n/en.json';
import { getCollection } from 'astro:content';
import { t } from '../i18n/ui';

const locale = 'en';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Guide pubblicate delle lame (Blade e Main Blade CX): link statici nell'HTML, così Google le trova
// dalla home invece che solo dal footer, e le card dell'isola linkano le stesse pagine.
const bladeEntries = (await getCollection('parts', (e) => !e.data.draft))
  .filter((e) => e.data.category === 'blade' || e.data.category === 'mainBlade');
const nameOf = (category: string, id: string): string => {
  const list = (category === 'mainBlade' ? partsData.mainBlades : partsData.blades) as Array<{ id: string; name: string }>;
  return list.find((p) => p.id === id)?.name ?? id;
};
const bladeGuides = bladeEntries
  .map((e) => ({ id: e.data.partId, name: nameOf(e.data.category, e.data.partId) }))
  .sort((a, b) => a.name.localeCompare(b.name));
// Il dataset intero NON passa come prop dell'isola (Astro lo serializzerebbe in un attributo HTML,
// raddoppiandolo): l'isola parte con le prime combo inline e fetcha /combos.json per il resto.
const slim = toSlim(combosData as unknown as CombosDatabase);
// Inline solo la finestra 12 (quella di default): le altre arrivano col fetch. Con tutte e quattro
// le finestre, 60 combo inline pesavano ~480 KB di HTML.
const initial = {
  ...slim,
  combos: slim.combos.slice(0, INITIAL_COMBOS).map((c) => ({ ...c, windows: { '365': c.windows['365'] } })),
};
const dataUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/combos.json`;
// Link affiliati Amazon (src/lib/amazon.ts): tag per marketplace in data/amazon-config.json, ASIN per
// codice set in data/amazon-asins.json (npm run sync:amazon-asins), lookup parte → set da products.json.
// `amazon` viene serializzato nell'HTML per il componente client, campo per campo:
// si passano solo i due che servono a costruire i link, mai il file intero. Fino al
// 21/09/2026 ci finiva anche il suo `_comment`, cioè delle note interne sugli account
// Associates, leggibili nel sorgente della homepage.
const amazon = {
  config: {
    defaultMarketplace: amazonConfig.defaultMarketplace,
    marketplaces: amazonConfig.marketplaces,
  } as AmazonConfigFile,
  lookup: buildPartLookup(productsData),
  asins: amazonAsins as AsinIndex,
};
---

<BaseLayout title={t(locale, 'home.title')}>
  <section data-testid="home-intro" class="mb-6">
    <h1 class="font-display text-2xl uppercase tracking-[0.01em] text-text lg:text-3xl">{t(locale, 'home.h1')}</h1>
    <p class="mt-2 max-w-[75ch] text-sm text-text-2">
      {t(locale, 'home.intro')}{' '}
      <a href={`${base}/about/`} class="text-gold hover:underline">{t(locale, 'home.introLink')}</a>
    </p>
    {bladeGuides.length > 0 && (
      <nav aria-label={t(locale, 'home.bladeGuides')} data-testid="home-blade-guides" class="mt-3">
        <h2 class="font-mono text-[10.5px] uppercase tracking-[0.12em] text-muted-2">{t(locale, 'home.bladeGuides')}</h2>
        <ul class="mt-1.5 flex flex-wrap gap-1.5">
          {bladeGuides.map((g) => (
            <li>
              <a href={`${base}/parts/${g.id}/`} class="inline-block rounded-md border border-border bg-surface-2 px-2 py-1 text-[12px] font-semibold text-text hover:text-gold">
                {t(locale, 'home.bladeGuideLink', { name: g.name })}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </section>
  <AdSlot name="top" />
  <ComboSearch
    client:load
    parts={partsData}
    initial={initial}
    dataUrl={dataUrl}
    amazon={amazon}
    locale={locale}
    translations={en}
    bladeGuides={{ base, ids: bladeGuides.map((g) => g.id) }}
  />
  <AdSlot name="bottom" />
</BaseLayout>
