---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/base-layout.astro';
import Breadcrumb from '../../components/seo/breadcrumb.astro';
import JsonLd from '../../components/seo/json-ld.astro';

const entries = (await getCollection('parts', (e) => import.meta.env.DEV || !e.data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site?.href.replace(/\/$/, '') ?? '';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: entries.map((e, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${site}${base}/parts/${e.data.partId}/`,
    name: e.data.title,
  })),
};
---

<BaseLayout title="Beyblade X Parts Guide" description="Blades, ratchets and bits explained: what they do, which sets have them, and how they perform in tournaments.">
  <Breadcrumb items={[{ name: 'Parts', href: `${base}/parts/` }]} />
  <JsonLd data={jsonLd} />
  <h1 class="mb-4 font-display text-2xl uppercase text-text lg:text-3xl">Parts Guide</h1>
  <p class="mb-6 text-muted">Individual write-ups on the parts that show up most in tournament-winning combos.</p>
  <ul class="flex flex-col gap-3">
    {entries.map((e) => (
      <li class="border-b border-border pb-3">
        <a href={`${base}/parts/${e.data.partId}/`} class="font-medium text-gold hover:underline">{e.data.title}</a>
        <p class="text-sm text-muted">{e.data.description}</p>
      </li>
    ))}
  </ul>
</BaseLayout>
