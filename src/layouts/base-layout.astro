---
import '../styles/global.css';
import Header from '../components/layout/header.astro';
import Footer from '../components/layout/footer.astro';
import { getLocaleFromUrl, t } from '../i18n/ui';
import { ADSENSE_CLIENT } from '../lib/ads-config';

interface Props {
  title?: string;
  description?: string;
}

const locale = getLocaleFromUrl(Astro.url);
const { title = t(locale, 'site.title'), description = t(locale, 'site.description') } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// URL assoluti per canonical/Open Graph: `site` da astro.config.mjs + path della pagina (con base).
// Le pagine sono directory (`/about/`): il canonical porta sempre lo slash finale, come la sitemap.
const pathname = /\.[a-z0-9]+$/i.test(Astro.url.pathname) || Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = Astro.site ? new URL(pathname, Astro.site).href : Astro.url.href;
const ogImage = Astro.site ? new URL(`${base}/og.png`, Astro.site).href : `${base}/og.png`;
const adsEnabled = import.meta.env.PROD && !!ADSENSE_CLIENT;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" href={`${base}/favicon.ico`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t(locale, 'site.title')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {adsEnabled && (
      <script async is:inline src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`} crossorigin="anonymous"></script>
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Saira:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t !== 'dark' && t !== 'light') {
            t = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          }
          document.documentElement.dataset.theme = t;
        } catch (e) {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
    <script>
      // Analytics PostHog cookieless (src/lib/analytics.ts): no-op in dev e senza chiave configurata.
      import { initAnalytics } from '../lib/analytics';
      initAnalytics();
    </script>
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-bg text-text">
    <Header locale={locale} />
    <main class="mx-auto max-w-[1180px] px-4 py-6 lg:px-10">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
